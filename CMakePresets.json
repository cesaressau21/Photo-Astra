{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "core-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PHOTO_ASTRA_BUILD_UI": "OFF",
        "PHOTO_ASTRA_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core Debug (no Qt/Skia)",
      "inherits": "core-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "core-release",
      "displayName": "Core Release (no Qt/Skia)",
      "inherits": "core-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "core-debug", "configurePreset": "core-debug" },
    { "name": "core-release", "configurePreset": "core-release" }
  ],
  "testPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 30 }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 30 }
    }
  ]
}
